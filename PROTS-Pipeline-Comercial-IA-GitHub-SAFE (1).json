            {
              "name": "X-OpenRouter-Title",
              "value": "PROTS Pipeline Comercial IA"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{\n  {\n    model: \"openai/gpt-oss-20b:free\",\n    messages: [\n      {\n        role: \"system\",\n        content:\n          \"Eres un Analista Comercial Senior de PROTS SRL. \" +\n          \"Devuelve exclusivamente un objeto JSON válido, \" +\n          \"sin Markdown, introducciones ni explicaciones.\"\n      },\n      {\n        role: \"user\",\n        content:\n          \"Analiza este prospecto comercial:\\n\\n\" +\n          \"Empresa: \" + $(\"Edit Fields\").item.json.empresa + \"\\n\" +\n          \"Contacto: \" + $(\"Edit Fields\").item.json.contacto + \"\\n\" +\n          \"Email: \" + $(\"Edit Fields\").item.json.email + \"\\n\" +\n          \"Prioridad: \" + $(\"Edit Fields\").item.json.prioridad + \"\\n\" +\n          \"Descripción: \" + $(\"Edit Fields\").item.json.descripcion + \"\\n\\n\" +\n          \"La clasificacion debe ser exactamente VIP, Urgente, Normal o Baja Prioridad.\\n\" +\n          \"El score debe ser un número entero entre 0 y 100.\\n\\n\" +\n          \"Devuelve exactamente:\\n\" +\n          \"{\\\"clasificacion\\\":\\\"\\\",\\\"score\\\":0,\\\"resumen\\\":\\\"\\\",\\\"accion\\\":\\\"\\\"}\"\n      }\n    ],\n    response_format: {\n      type: \"json_object\"\n    },\n    reasoning: {\n      effort: \"minimal\",\n      exclude: true\n    },\n    temperature: 0.1,\n    max_tokens: 1000,\n    stream: false\n  }\n}}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        -16,
        -240
      ],
      "id": "1fc9dff2-d530-4d14-af41-e455e974d6ac",
      "name": "HTTP Request"
    },
    {
      "parameters": {
        "jsCode": "const message = $json?.choices?.[0]?.message;\n\nif (!message) {\n  throw new Error(\n    `OpenRouter no devolvió message: ${JSON.stringify($json)}`\n  );\n}\n\nlet content = message.content;\n\nif (Array.isArray(content)) {\n  content = content\n    .map((part) => part?.text || part?.content || \"\")\n    .join(\"\");\n}\n\nconst text = String(content || \"\")\n  .replace(/```json/gi, \"\")\n  .replace(/```/g, \"\")\n  .trim();\n\nif (!text) {\n  throw new Error(\"OpenRouter devolvió contenido vacío\");\n}\n\nlet analysis;\n\n// Primer intento: interpretar JSON normal.\ntry {\n  analysis = JSON.parse(text);\n} catch {\n  // Segundo intento: extraer valores aunque el JSON venga mal formado.\n  const getString = (field) => {\n    const regex = new RegExp(\n      `\"${field}\"\\\\s*:\\\\s*\"([\\\\s\\\\S]*?)\"(?=\\\\s*,\\\\s*\"|\\\\s*})`,\n      \"i\"\n    );\n\n    return text.match(regex)?.[1]\n      ?.replace(/\\\\\"/g, '\"')\n      ?.trim() || \"\";\n  };\n\n  const scoreMatch = text.match(\n    /\"score\"\\s*:\\s*\"?(\\d{1,3})\"?/i\n  );\n\n  analysis = {\n    clasificacion: getString(\"clasificacion\"),\n    score: scoreMatch ? Number(scoreMatch[1]) : 0,\n    resumen: getString(\"resumen\"),\n    accion: getString(\"accion\"),\n  };\n}\n\nconst classifications = {\n  vip: \"VIP\",\n  urgente: \"Urgente\",\n  normal: \"Normal\",\n  \"baja prioridad\": \"Baja Prioridad\",\n};\n\nconst classificationKey = String(\n  analysis.clasificacion || \"\"\n)\n  .trim()\n  .toLowerCase();\n\nconst clasificacion =\n  classifications[classificationKey] || \"Normal\";\n\nconst score = Math.max(\n  0,\n  Math.min(100, Number(analysis.score) || 0)\n);\n\nconst original = $(\"Edit Fields\").item.json;\n\nreturn [\n  {\n    json: {\n      empresa: original.empresa,\n      contacto: original.contacto,\n      email: original.email,\n      prioridad: original.prioridad,\n      descripcion: original.descripcion,\n      clasificacion_ia: clasificacion,\n      score_ia: score,\n      resumen_ia: String(analysis.resumen || \"\").trim(),\n      accion_recomendada: String(\n        analysis.accion || \"\"\n      ).trim(),\n    },\n  },\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        96,
